{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "kilo-router": {
      "type": "local",
      "command": [
        "/home/krzysiek/basal-env/bin/python",
        "/media/magazyn/home/teresa/Dokumenty/HYC/basal/router_mcp.py"
      ],
      "enabled": true,
      "timeout": 300000,
      "environment": { "BASAL_ROUTER_POOL": "registry" }
    }
  },
  "permission": {
    "kilo-router_recommend": "allow",
    "kilo-router_pool": "allow",
    "kilo-router_route": "allow",
    "kilo-router_models": "allow",
    "kilo-router_run": "ask"
  },
  "provider": {
    "router": {
      "options": {
        "baseURL": "http://127.0.0.1:8788/v1",
        "apiKey": "router-local",
        "timeout": 300000
      },
      "models": {
        "auto": {
          "name": "Basal Router (auto)",
          "context_window": 8192,
          "max_tokens": 4096,
          "features": ["chat"]
        }
      }
    }
  }
}
