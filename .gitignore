
# secrets — never commit
providers.json
providers.*.json
settings.json
.env
.env.*
*.env
*.key
api_keys*.json
secrets*.json

# local runtime state (may contain private task texts)
decisions.jsonl
decisions.*.jsonl

# python
__pycache__/
*.pyc

# experiments scratch (resumable progress snapshots)
experiments/results/progress_*
opt/gepa_result/gepa_state.bin
opt/gepa_result/live.log
opt/gepa_result/generated_best_outputs_valset/
opt/abstral/cycle.log
opt/abstral/scratch/
opt/discovery/refresh.log
opt/performance/metrics.jsonl
opt/rpm/state.json

# hermes sandbox: runtime state stays out of git, only the intended config is tracked
opt/hermes_sandbox/home/*
!opt/hermes_sandbox/home/config.yaml
opt/hermes_sandbox/scratch/

# os / editor junk
.DS_Store
*.swp
